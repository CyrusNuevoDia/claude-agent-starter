# Every variable here is required — lib/env.ts validates them at import and
# fails loudly if one is missing or empty.

# Claude API key — https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Case discovery (find-cases skill)
PARALLEL_API_KEY=
EXA_API_KEY=

# Browser Use cloud browser agent (submit-request skill)
BROWSER_USE_API_KEY=

# Standing portal identity for submit-request account registration/sign-in
PORTAL_LOGIN_EMAIL=
PORTAL_LOGIN_PASSWORD=

# FOIA tracking spreadsheet (worksheet skill)
FOIA_SHEET_ID=
GOOGLE_SA_KEY_FILE=
